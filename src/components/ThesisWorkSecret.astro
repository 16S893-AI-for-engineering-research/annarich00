<section id="thesis-work-secret" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 px-4 py-8 backdrop-blur-sm">
  <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-slate-950/95 p-6 shadow-2xl shadow-black/60">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-2xl font-bold text-white">Thesis Work</h2>
      <button
        type="button"
        id="thesis-work-close"
        class="rounded-full border border-white/15 px-3 py-1 text-sm text-slate-300 transition hover:border-orbital hover:text-white"
        aria-label="Close thesis work section"
      >
        Close
      </button>
    </div>
    <p class="mt-4 text-slate-300">
      Hidden thesis work section. You can use this area for drafts, notes, or thesis-only content.
    </p>
    <div class="mt-4 rounded-xl border border-white/10 bg-white/5 p-4 text-slate-200 space-y-2">
      <p class="font-semibold">Research site</p>
      <p>Open the thesis research site in a new tab:</p>
      <a class="inline-block text-orbital underline" href="https://16s893-ai-for-engineering-research.github.io/annarich00/" target="_blank" rel="noreferrer">https://16s893-ai-for-engineering-research.github.io/annarich00/</a>
    </div>
  </div>
</section>

<script is:inline>
  const panel = document.getElementById('thesis-work-secret');
  const closeButton = document.getElementById('thesis-work-close');
  const openPanel = () => {
    if (panel) panel.classList.remove('hidden');
    if (panel) panel.classList.add('flex');
    window.location.href = '/annarich00/presentation';
  };

  const closePanel = () => {
    if (panel) panel.classList.add('hidden');
    if (panel) panel.classList.remove('flex');
  };

  window.addEventListener('keydown', (event) => {
    if (event.ctrlKey && event.key.toLowerCase() === 's') {
      event.preventDefault();
      openPanel();
    }

    if (event.key === 'Escape') {
      closePanel();
    }
  });

  closeButton?.addEventListener('click', closePanel);
</script>
