---
import { resolvePath } from '../lib/paths';

const links = [
  { href: resolvePath('/'), label: 'Home' },
  { href: resolvePath('/about'), label: 'About' },
  { href: resolvePath('/project'), label: 'Project' },
  { href: resolvePath('/schedule'), label: 'Schedule' },
  { href: resolvePath('/dev-log'), label: 'Dev Log' },
];
---

<header class="border-b border-white/10 bg-void/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a class="text-lg font-semibold tracking-wide text-white" href={resolvePath('/')}>
      AI-Assisted Trajectory Design
    </a>
    <nav class="flex flex-wrap gap-3 text-sm text-slate-300">
      {links.map((link) => (
        <a class="transition hover:text-orbital" href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>
