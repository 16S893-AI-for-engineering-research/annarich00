---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePath } from '../lib/paths';
---

<BaseLayout title="Trajectory Copilot" description="Anna Ford-Richards research portfolio on AI-assisted trajectory design and cislunar mission planning.">
  <section class="hero-orbit grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="mb-4 text-sm uppercase tracking-[0.3em] text-orbital">Mission Minded</p>
      <h1 class="text-5xl font-bold leading-tight sm:text-6xl">Trajectory Copilot</h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-300">
        I am researching how large language models can work alongside physics-based astrodynamics tools to assist trajectory design and mission planning for future cislunar space operations. This semester project focuses on understanding where agentic models can help mission planners without stepping outside physically valid, engineering-safe bounds.
      </p>
      <p class="mt-4 max-w-2xl text-slate-300">
        The project centers on three goals: benchmark LLMs on known astrodynamics problems, validate their outputs in tools like GMAT or Python workflows, and define the guardrails for where agentic models can responsibly assist mission planners.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="rounded-full bg-orbital px-5 py-3 font-semibold text-slate-950 transition hover:opacity-90" href={resolvePath('/project')}>Project</a>
        <a class="rounded-full border border-white/15 px-5 py-3 font-semibold text-white transition hover:border-orbital" href={resolvePath('/about')}>About</a>
        <a class="rounded-full border border-white/15 px-5 py-3 font-semibold text-white transition hover:border-thruster" href={resolvePath('/dev-log')}>Dev Log</a>
      </div>
    </div>
    <div class="moon"></div>
    <div class="craft craft-1"></div>
    <div class="craft craft-2"></div>
    <div class="craft craft-3"></div>
    <div class="card">
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-white/10 bg-black/20 p-4">
          <p class="text-sm text-orbital">Goal 1</p>
          <p class="mt-2 text-sm text-slate-300">Benchmark how well LLMs can reproduce and explain known trajectory design problems.</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-black/20 p-4">
          <p class="text-sm text-thruster">Goal 2</p>
          <p class="mt-2 text-sm text-slate-300">Check whether LLM outputs can be validated inside GMAT or Python astrodynamics workflows.</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-black/20 p-4">
          <p class="text-sm text-white">Goal 3</p>
          <p class="mt-2 text-sm text-slate-300">Define the guardrails for where agentic models can responsibly assist mission planners.</p>
        </div>
      </div>
    </div>
  </section>
  <style>
    .hero-orbit {
      position: relative;
      overflow: hidden;
    }

    .hero-orbit::before,
    .hero-orbit::after,
    .hero-orbit .moon,
    .hero-orbit .craft {
      content: '';
      position: absolute;
      pointer-events: none;
      z-index: 0;
    }

    .hero-orbit::before {
      width: 220vw;
      height: 170vw;
      left: -70vw;
      top: -22vw;
      border-radius: 50%;
      border: 1px solid rgba(121, 242, 255, 0.12);
      box-shadow:
        0 0 0 1px rgba(121, 242, 255, 0.04) inset,
        0 0 110px rgba(121, 242, 255, 0.04);
      background:
        radial-gradient(ellipse at 48% 56%, transparent 0 64%, rgba(121, 242, 255, 0.09) 64.5% 65%, transparent 65.5%),
        radial-gradient(ellipse at 58% 44%, transparent 0 76%, rgba(255, 179, 71, 0.07) 76.5% 77%, transparent 77.5%),
        radial-gradient(ellipse at 50% 52%, transparent 0 86%, rgba(121, 242, 255, 0.05) 86.5% 87%, transparent 87.5%);
      opacity: 0.9;
      transform-origin: center;
      filter: blur(0.5px);
      animation: orbitDrift 56s linear infinite;
    }

    .hero-orbit .moon {
      width: 42px;
      height: 42px;
      right: 10%;
      top: 12%;
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.9), rgba(225, 228, 235, 0.68) 24%, rgba(156, 163, 177, 0.8) 52%, rgba(73, 79, 92, 0.88) 78%, rgba(35, 38, 48, 1) 100%);
      box-shadow:
        inset -8px -9px 14px rgba(0, 0, 0, 0.33),
        inset 6px 6px 9px rgba(255, 255, 255, 0.1),
        0 0 14px rgba(255, 255, 255, 0.08);
      overflow: hidden;
      filter: blur(0.8px);
      opacity: 0.7;
      animation: moonOrbit 42s linear infinite;
    }

    .hero-orbit .moon::before,
    .hero-orbit .moon::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.07);
    }

    .hero-orbit .moon::before {
      width: 10px;
      height: 7px;
      left: 8px;
      top: 11px;
      box-shadow: 10px 14px 0 rgba(255, 255, 255, 0.05), 14px 2px 0 rgba(255, 255, 255, 0.04), 18px 12px 0 rgba(255, 255, 255, 0.03);
    }

    .hero-orbit .moon::after {
      width: 7px;
      height: 5px;
      right: 10px;
      bottom: 10px;
      box-shadow: -12px -14px 0 rgba(255, 255, 255, 0.05), -16px 1px 0 rgba(255, 255, 255, 0.04);
    }

    .hero-orbit .craft {
      width: 14px;
      height: 14px;
      border-radius: 50% 50% 42% 42%;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(183, 194, 213, 0.86));
      box-shadow: 0 0 10px rgba(121, 242, 255, 0.18);
      filter: blur(1.2px);
      opacity: 0.42;
      animation: craftOrbit 36s linear infinite;
      transform-origin: center;
    }

    .hero-orbit .craft::before,
    .hero-orbit .craft::after {
      content: '';
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(220, 230, 245, 0.8);
    }

    .hero-orbit .craft::before {
      left: -7px;
      width: 6px;
      height: 14px;
      border-radius: 4px;
    }

    .hero-orbit .craft::after {
      right: -7px;
      width: 6px;
      height: 14px;
      border-radius: 4px;
    }

    .hero-orbit .craft-1 { left: 8%; top: 24%; animation-duration: 28s; }
    .hero-orbit .craft-2 { left: 44%; top: 14%; animation-duration: 34s; animation-delay: -9s; }
    .hero-orbit .craft-3 { left: 70%; top: 66%; animation-duration: 40s; animation-delay: -18s; }

    .hero-orbit .moon {
      width: 54px;
      height: 54px;
      right: 28px;
      top: 72px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.92), rgba(220, 225, 235, 0.75) 25%, rgba(150, 160, 175, 0.9) 55%, rgba(85, 92, 108, 0.95) 82%, rgba(45, 48, 59, 1) 100%);
      box-shadow:
        inset -10px -12px 16px rgba(0, 0, 0, 0.35),
        inset 7px 7px 10px rgba(255, 255, 255, 0.14),
        0 0 18px rgba(255, 255, 255, 0.12);
      overflow: hidden;
      animation: moonOrbit 18s linear infinite;
    }

    .hero-orbit .moon::before,
    .hero-orbit .moon::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
    }

    .hero-orbit .moon::before {
      width: 14px;
      height: 10px;
      left: 10px;
      top: 14px;
      box-shadow: 14px 18px 0 rgba(255, 255, 255, 0.06), 18px 2px 0 rgba(255, 255, 255, 0.05), 24px 16px 0 rgba(255, 255, 255, 0.04);
      background: rgba(255, 255, 255, 0.06);
    }

    .hero-orbit .moon::after {
      width: 9px;
      height: 7px;
      right: 12px;
      bottom: 12px;
      box-shadow: -16px -18px 0 rgba(255, 255, 255, 0.06), -22px 1px 0 rgba(255, 255, 255, 0.05);
      background: rgba(255, 255, 255, 0.05);
    }

    .hero-orbit .craft::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      width: 28px;
      height: 2px;
      background: linear-gradient(90deg, rgba(121, 242, 255, 0), rgba(121, 242, 255, 0.75), rgba(121, 242, 255, 0));
      transform: translate(-50%, -50%) rotate(24deg);
      filter: blur(0.5px);
      opacity: 0.8;
    }

    @keyframes orbitDrift {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes moonOrbit {
      0% { transform: translate(0, 0) rotate(0deg) translateX(0) scale(1); }
      25% { transform: translate(-120px, 72px) rotate(90deg) translateX(8px) scale(1.02); }
      50% { transform: translate(-200px, 18px) rotate(180deg) translateX(0) scale(0.98); }
      75% { transform: translate(-108px, -66px) rotate(270deg) translateX(-8px) scale(1.01); }
      100% { transform: translate(0, 0) rotate(360deg) translateX(0) scale(1); }
    }

    @keyframes craftOrbit {
      0% { transform: translate(0, 0) rotate(0deg); }
      20% { transform: translate(180px, 86px) rotate(70deg); }
      40% { transform: translate(420px, 16px) rotate(165deg); }
      60% { transform: translate(620px, 170px) rotate(250deg); }
      80% { transform: translate(920px, 42px) rotate(320deg); }
      100% { transform: translate(1180px, 120px) rotate(360deg); }
    }

    .hero-orbit > * {
      position: relative;
      z-index: 1;
    }

    @keyframes orbitDrift {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes moonDrift {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-18px, 12px) scale(1.03); }
      100% { transform: translate(0, 0) scale(1); }
    }
  </style>
</BaseLayout>
