---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePath } from '../lib/paths';
---

<BaseLayout title="Trajectory Copilot" description="Anna Ford-Richards research portfolio on AI-assisted trajectory design and cislunar mission planning.">
  <section class="hero-orbit grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="mb-4 text-sm uppercase tracking-[0.3em] text-orbital">Mission Minded</p>
      <h1 class="text-5xl font-bold leading-tight sm:text-6xl">Trajectory Copilot</h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-300">
        I am researching how large language models can work alongside physics-based astrodynamics tools to assist trajectory design and mission planning for future cislunar space operations. This semester project focuses on understanding where agentic models can help mission planners without stepping outside physically valid, engineering-safe bounds.
      </p>
      <p class="mt-4 max-w-2xl text-slate-300">
        The project centers on three goals: benchmark LLMs on known astrodynamics problems, validate their outputs in tools like GMAT or Python workflows, and define the guardrails for where agentic models can responsibly assist mission planners.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="rounded-full bg-orbital px-5 py-3 font-semibold text-slate-950 transition hover:opacity-90" href={resolvePath('/project')}>Project</a>
        <a class="rounded-full border border-white/15 px-5 py-3 font-semibold text-white transition hover:border-orbital" href={resolvePath('/about')}>About</a>
        <a class="rounded-full border border-white/15 px-5 py-3 font-semibold text-white transition hover:border-thruster" href={resolvePath('/dev-log')}>Dev Log</a>
      </div>
    </div>
    <div class="earth"></div>
    <div class="moon"></div>
    <div class="satellite sat-1"></div>
    <div class="satellite sat-2"></div>
    <div class="satellite sat-3"></div>
    <div class="card">
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-white/10 bg-black/20 p-4">
          <p class="text-sm text-orbital">Goal 1</p>
          <p class="mt-2 text-sm text-slate-300">Benchmark how well LLMs can reproduce and explain known trajectory design problems.</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-black/20 p-4">
          <p class="text-sm text-thruster">Goal 2</p>
          <p class="mt-2 text-sm text-slate-300">Check whether LLM outputs can be validated inside GMAT or Python astrodynamics workflows.</p>
        </div>
        <div class="rounded-xl border border-white/10 bg-black/20 p-4">
          <p class="text-sm text-white">Goal 3</p>
          <p class="mt-2 text-sm text-slate-300">Define the guardrails for where agentic models can responsibly assist mission planners.</p>
        </div>
      </div>
    </div>
  </section>
  <style>
    .hero-orbit {
      position: relative;
      overflow: hidden;
    }

    .hero-orbit::before,
    .hero-orbit::after,
    .hero-orbit .earth,
    .hero-orbit .moon,
    .hero-orbit .satellite {
      content: '';
      position: absolute;
      pointer-events: none;
      z-index: 0;
    }

    .hero-orbit::before {
      width: 680px;
      height: 680px;
      right: -220px;
      top: -10px;
      border-radius: 50%;
      border: 1px solid rgba(121, 242, 255, 0.24);
      box-shadow:
        0 0 0 1px rgba(121, 242, 255, 0.06) inset,
        0 0 60px rgba(121, 242, 255, 0.08);
      background:
        radial-gradient(circle at 50% 50%, transparent 0 69%, rgba(121, 242, 255, 0.08) 70% 70.5%, transparent 71%),
        radial-gradient(circle at 50% 50%, transparent 0 82%, rgba(255, 179, 71, 0.12) 83% 83.5%, transparent 84%),
        radial-gradient(circle at center, rgba(5, 8, 22, 0.0) 0 64%, rgba(121, 242, 255, 0.05) 65%, rgba(5, 8, 22, 0.0) 66%);
      opacity: 0.95;
      animation: orbitDrift 28s linear infinite;
    }

    .hero-orbit .earth {
      width: 260px;
      height: 260px;
      left: -95px;
      bottom: -25px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 30%, rgba(120, 190, 255, 0.95), rgba(55, 112, 194, 0.82) 35%, rgba(14, 44, 94, 0.95) 62%, rgba(4, 14, 34, 1) 100%),
        radial-gradient(circle at 28% 24%, rgba(255, 255, 255, 0.22), transparent 18%),
        radial-gradient(circle at 52% 55%, rgba(40, 149, 116, 0.95) 0 10%, transparent 11%),
        radial-gradient(circle at 62% 40%, rgba(78, 170, 126, 0.95) 0 8%, transparent 9%),
        radial-gradient(circle at 45% 68%, rgba(50, 135, 92, 0.9) 0 9%, transparent 10%),
        radial-gradient(circle at 68% 72%, rgba(54, 127, 90, 0.9) 0 7%, transparent 8%),
        radial-gradient(circle at 25% 62%, rgba(66, 149, 100, 0.88) 0 8%, transparent 9%),
        radial-gradient(circle at 58% 30%, rgba(246, 231, 187, 0.9) 0 4%, transparent 5%);
      box-shadow:
        0 0 50px rgba(78, 149, 255, 0.18),
        inset -24px -28px 30px rgba(4, 14, 34, 0.4),
        inset 10px 8px 26px rgba(255, 255, 255, 0.08);
      filter: saturate(1.05);
      opacity: 0.88;
    }

    .hero-orbit .earth::before {
      content: '';
      position: absolute;
      inset: 16px 18px 22px 16px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.12), transparent 14%),
        radial-gradient(circle at 62% 62%, rgba(5, 8, 22, 0.18), transparent 22%),
        radial-gradient(circle at 52% 40%, rgba(255, 255, 255, 0.05), transparent 35%);
      mix-blend-mode: screen;
    }

    .hero-orbit .moon {
      width: 54px;
      height: 54px;
      right: 28px;
      top: 72px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.92), rgba(220, 225, 235, 0.75) 25%, rgba(150, 160, 175, 0.9) 55%, rgba(85, 92, 108, 0.95) 82%, rgba(45, 48, 59, 1) 100%);
      box-shadow:
        inset -10px -12px 16px rgba(0, 0, 0, 0.35),
        inset 7px 7px 10px rgba(255, 255, 255, 0.14),
        0 0 18px rgba(255, 255, 255, 0.12);
      overflow: hidden;
      animation: moonOrbit 18s linear infinite;
    }

    .hero-orbit .moon::before,
    .hero-orbit .moon::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
    }

    .hero-orbit .moon::before {
      width: 14px;
      height: 10px;
      left: 10px;
      top: 14px;
      box-shadow: 14px 18px 0 rgba(255, 255, 255, 0.06), 18px 2px 0 rgba(255, 255, 255, 0.05), 24px 16px 0 rgba(255, 255, 255, 0.04);
      background: rgba(255, 255, 255, 0.06);
    }

    .hero-orbit .moon::after {
      width: 9px;
      height: 7px;
      right: 12px;
      bottom: 12px;
      box-shadow: -16px -18px 0 rgba(255, 255, 255, 0.06), -22px 1px 0 rgba(255, 255, 255, 0.05);
      background: rgba(255, 255, 255, 0.05);
    }

    .hero-orbit .satellite {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.95), rgba(121, 242, 255, 0.7) 45%, rgba(44, 118, 255, 0.25) 100%);
      box-shadow: 0 0 12px rgba(121, 242, 255, 0.6);
      animation: objectOrbit 9s linear infinite;
    }

    .hero-orbit .satellite.sat-1 { right: 90px; top: 160px; animation-duration: 10s; }
    .hero-orbit .satellite.sat-2 { right: 190px; top: 34px; animation-duration: 13s; animation-delay: -3s; }
    .hero-orbit .satellite.sat-3 { right: 40px; top: 290px; animation-duration: 15s; animation-delay: -7s; }

    .hero-orbit .satellite::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      width: 28px;
      height: 2px;
      background: linear-gradient(90deg, rgba(121, 242, 255, 0), rgba(121, 242, 255, 0.75), rgba(121, 242, 255, 0));
      transform: translate(-50%, -50%) rotate(24deg);
      filter: blur(0.5px);
      opacity: 0.8;
    }

    @keyframes orbitDrift {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes moonOrbit {
      0% { transform: translate(0, 0) rotate(0deg) translateX(0) scale(1); }
      25% { transform: translate(-90px, 66px) rotate(90deg) translateX(10px) scale(1.02); }
      50% { transform: translate(-170px, 18px) rotate(180deg) translateX(0) scale(0.98); }
      75% { transform: translate(-85px, -58px) rotate(270deg) translateX(-10px) scale(1.01); }
      100% { transform: translate(0, 0) rotate(360deg) translateX(0) scale(1); }
    }

    @keyframes objectOrbit {
      from { transform: rotate(0deg) translateX(0) rotate(0deg); }
      to { transform: rotate(360deg) translateX(0) rotate(-360deg); }
    }

    .hero-orbit > * {
      position: relative;
      z-index: 1;
    }

    @keyframes orbitDrift {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes moonDrift {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-18px, 12px) scale(1.03); }
      100% { transform: translate(0, 0) scale(1); }
    }
  </style>
</BaseLayout>
