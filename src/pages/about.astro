---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Anna Ford-Richards" description="Background, research interests, and project motivation.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">About Anna</h1>
    <p class="max-w-3xl text-slate-300">
      Anna Ford-Richards is a Space Force fellow interested in cislunar operations, orbital analysis, and the use of agents to support research workflows. She is pursuing this project to understand where AI can meaningfully assist in rendezvous analysis without losing technical rigor.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <img src="/agent_retry/images/wedding-charlie.jpg" alt="Personal photo" class="h-56 w-full rounded-2xl object-cover" />
      <img src="/agent_retry/images/wedding-charlie.jpg" alt="Personal photo" class="h-56 w-full rounded-2xl object-cover" />
      <img src="/agent_retry/images/wedding-charlie.jpg" alt="Personal photo" class="h-56 w-full rounded-2xl object-cover" />
