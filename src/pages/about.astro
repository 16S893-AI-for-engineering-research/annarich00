      filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.35));
    }

    .rocket-launch::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -68px;
      transform: translateX(-50%);
      width: 36px;
      height: 84px;
      background: radial-gradient(ellipse at center, rgba(255, 179, 71, 1), rgba(255, 108, 39, 0.8) 38%, rgba(121, 242, 255, 0.16) 70%, transparent 78%);
      clip-path: polygon(50% 0%, 66% 18%, 78% 42%, 88% 66%, 50% 100%, 12% 66%, 22% 42%, 34% 18%);
      filter: blur(2px);
      opacity: 0.98;
    }

    .rocket-trail {
      left: 50%;
      bottom: -12vh;
      width: 22px;
      height: 88vh;
      background: linear-gradient(180deg, rgba(255, 179, 71, 0.0), rgba(255, 179, 71, 0.72), rgba(121, 242, 255, 0.22), rgba(5, 8, 22, 0.0));
      filter: blur(18px);
      opacity: 0;
      transform: translateX(-50%);
    }

    .about-stage::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 60;
      pointer-events: none;
      opacity: 0;
      background:
        radial-gradient(circle at 50% 92%, rgba(121, 242, 255, 0.25), transparent 18%),
        linear-gradient(180deg, rgba(5, 8, 22, 0.0), rgba(121, 242, 255, 0.08), rgba(5, 8, 22, 0.0));
    }

    .about-stage.is-rumbling::before {
      animation: pageRumble 2.8s linear forwards;
    }

    .about-stage.is-rumbling .space-shake,
    .about-stage.is-rumbling .space-shake * {
      animation: contentShake 0.38s linear infinite;
      will-change: transform;
    }

    .about-stage.is-rumbling .rocket-rumble {
      animation: pageRumble 2.8s linear forwards;
    }

    .about-stage.is-rumbling .rocket-whoosh {
      animation: pageWhoosh 2.8s ease-out forwards;
    }

    .about-stage.is-rumbling .rocket-launch {
      animation: rocketLaunch 2.8s linear forwards;
    }

    .about-stage.is-rumbling .rocket-trail {
      animation: trailGlow 2.8s ease-out forwards;
    }

    @keyframes pageRumble {
      0% { opacity: 0; }
      8% { opacity: 0.9; }
      24% { opacity: 1; }
      100% { opacity: 0; }
    }

    @keyframes pageWhoosh {
      0% { opacity: 0; }
      10% { opacity: 0.8; }
      35% { opacity: 1; }
      100% { opacity: 0; }
    }

    @keyframes rocketLaunch {
      0% { opacity: 0; transform: translateX(-50%) translateY(0) scale(0.68) rotate(-6deg); }
      8% { opacity: 1; transform: translateX(-50%) translateY(0) scale(0.72) rotate(-6deg); }
      18% { transform: translateX(-50%) translateY(-14vh) scale(0.82) rotate(-2deg); }
      34% { transform: translateX(-50%) translateY(-34vh) scale(0.94) rotate(3deg); }
      52% { transform: translateX(-50%) translateY(-60vh) scale(1.04) rotate(8deg); }
      72% { transform: translateX(-50%) translateY(-88vh) scale(1.12) rotate(12deg); }
      100% { opacity: 1; transform: translateX(-50%) translateY(-118vh) scale(1.18) rotate(16deg); }
    }

    @keyframes trailGlow {
      0% { opacity: 0; }
      12% { opacity: 0.95; }
      55% { opacity: 0.82; }
      100% { opacity: 0; }
    }

    @keyframes contentShake {
      0% { transform: translate(0, 0) rotate(0deg); }
      20% { transform: translate(-4px, 3px) rotate(-0.25deg); }
      40% { transform: translate(5px, -4px) rotate(0.25deg); }
      60% { transform: translate(-5px, 4px) rotate(-0.2deg); }
      80% { transform: translate(4px, -3px) rotate(0.2deg); }
      100% { transform: translate(0, 0) rotate(0deg); }
    }
  </style>
</BaseLayout>
