---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePath } from '../lib/paths';

const photos = [
  { src: '/images/wedding-charlie.jpg', alt: 'Anna and Charlie at a wedding' },
  { src: '/images/ULArocket-photo.jpg', alt: 'Anna near a ULA rocket' },
  { src: '/images/backpacking.jpg', alt: 'Anna backpacking outdoors' },
  { src: '/images/faith.jpg', alt: 'Anna at church or a faith event' },
  { src: '/images/surf-anna.jpg', alt: 'Anna surfing' },
  { src: '/images/family.jpg', alt: 'Anna with family' },
];
---

<BaseLayout title="About | Anna Ford-Richards" description="Background, research interests, and project motivation.">
  <section class="space-y-8">
    <div class="space-y-4">
      <h1 class="text-4xl font-bold">About Anna</h1>
      <p class="max-w-3xl text-slate-300">
        Anna Ford-Richards is a Space Force fellow focused on cislunar operations, orbital analysis, and how agents can support research and engineering workflows. Her time as a Space Force engineer at Vandenberg gave her firsthand experience working with launch companies, helping bridge technical requirements, operational coordination, and mission execution.
      </p>
      <p class="max-w-3xl text-slate-300">
        She took on this project because she sees a real gap between what agents can say about rendezvous and what operators can actually use. Outside of the classroom, Anna loves backpacking, hiking, and just about any outdoor sport, and she brings the same curiosity and energy to research that she does to time outdoors. Faith and family are deeply important to her, and she and her husband were active in a wonderful church community in California where they helped with kids' church. She is also, proudly, a chocolate lover.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {photos.map((photo) => (
        <img src={resolvePath(photo.src)} alt={photo.alt} class="h-56 w-full rounded-2xl object-cover" />
      ))}
    </div>
  </section>
</BaseLayout>
