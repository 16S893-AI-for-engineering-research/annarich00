---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePath } from '../lib/paths';

const photos = [
  {
    src: '/images/wedding-charlie.jpg',
    alt: 'Anna and Charlie at a wedding',
    span: 'md:col-span-2 md:row-span-2 object-[50%_35%]',
  },
  {
    src: '/images/ULArocket-photo.jpg',
    alt: 'Anna near a ULA rocket',
    span: 'rocket-card md:col-span-1 md:row-span-2 object-[50%_40%]',
  },
  { src: '/images/backpacking.jpg', alt: 'Anna backpacking outdoors', span: 'md:col-span-1' },
  { src: '/images/faith.jpg', alt: 'Anna at church or a faith event', span: 'md:col-span-1 object-[50%_38%]' },
  { src: '/images/surf-anna.jpg', alt: 'Anna surfing', span: 'md:col-span-1' },
  { src: '/images/family.jpg', alt: 'Anna with family', span: 'md:col-span-1' },
];
---

<BaseLayout title="Hiya! I'm Anna" description="Background, research interests, and project motivation.">
  <section class="about-stage space-y-8">
    <div class="space-shake space-y-8">
      <div class="space-y-4">
        <h1 class="text-4xl font-bold">Welcome! I&apos;m Anna</h1>
        <p class="max-w-3xl text-slate-300">
          I am a Space Force fellow focused on cislunar operations, orbital analysis, and AI-assisted trajectory design for space mission planning. My time as a Space Force engineer at Vandenberg gave me firsthand experience working with launch companies, helping bridge technical requirements, operational coordination, and mission execution.
        </p>
        <p class="max-w-3xl text-slate-300">
          I chose this project with my advisor because I see a real gap between what large language models can say about trajectory design and what active-duty operators and engineers can actually use. Outside of the classroom, my husband, Charlie, and I love backpacking, surfing, and just about any outdoor sport! We got married in April of this year and I have a photo of that below along with some others. I hope to bring the same curiosity and energy to research here at MIT. Faith and family are deeply important to me, and Charlie and I were active in a wonderful church community in California where we helped with kids' church.
        </p>
        <p class="max-w-3xl text-orbital/90">
          Click my rocket photo for a fun surprise ;)
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3 md:auto-rows-[180px]">
        {photos.map((photo) => (
          <figure class={`photo-card group relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-glow ${photo.span}`}>
            {photo.src === '/images/ULArocket-photo.jpg' ? (
              <button type="button" class="rocket-trigger h-full w-full text-left" aria-label="Launch rocket animation" data-rocket-trigger>
                <img src={resolvePath(photo.src)} alt={photo.alt} class="h-full w-full object-cover object-[50%_40%]" />
                <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-black/60 px-3 py-2 text-xs text-white/90 backdrop-blur">
                  Click to launch
                </span>
              </button>
            ) : (
              <img src={resolvePath(photo.src)} alt={photo.alt} class={`h-full w-full object-cover transition duration-500 group-hover:scale-105 group-hover:brightness-110 ${photo.src === '/images/wedding-charlie.jpg' ? 'object-[50%_35%]' : ''} ${photo.src === '/images/faith.jpg' ? 'object-[50%_38%]' : ''}`} />
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <div class="rocket-rumble pointer-events-none fixed inset-0 z-[70] opacity-0"></div>
  <div class="rocket-whoosh pointer-events-none fixed inset-0 z-[80] opacity-0"></div>
  <div class="rocket-launch pointer-events-none fixed left-1/2 top-[95vh] z-[90] opacity-0"></div>
  <div class="rocket-trail pointer-events-none fixed left-1/2 top-[95vh] z-[85] opacity-0"></div>
  <div class="rocket-flash pointer-events-none fixed inset-0 z-[95] opacity-0"></div>

  <script is:inline>
    const stage = document.querySelector('.about-stage');
    const trigger = document.querySelector('[data-rocket-trigger]');
    if (stage && trigger) {
      const stopRumble = () => stage.classList.remove('is-rumbling');
      const startLaunch = () => {
        stage.classList.remove('is-rumbling');
        void stage.offsetWidth;
        stage.classList.add('is-rumbling');
        window.clearTimeout(window.__rocketTimeout);
        window.__rocketTimeout = window.setTimeout(stopRumble, 5000);
      };
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        startLaunch();
      });
    }
  </script>

  <style>
    .about-stage {
      position: relative;
      isolation: isolate;
    }

    .rocket-trigger {
      display: block;
      border: 0;
      padding: 0;
      background: transparent;
      cursor: pointer;
    }

    .rocket-rumble,
    .rocket-whoosh,
    .rocket-launch,
    .rocket-trail {
      will-change: transform, opacity;
      pointer-events: none;
    }

    .rocket-rumble {
      background:
        radial-gradient(circle at 50% 50%, rgba(121, 242, 255, 0.12), transparent 28%),
        radial-gradient(circle at 50% 90%, rgba(255, 179, 71, 0.12), transparent 18%);
      mix-blend-mode: screen;
    }

    .rocket-whoosh {
      background:
        radial-gradient(circle at 50% 88%, rgba(121, 242, 255, 0.28), transparent 18%),
        linear-gradient(180deg, rgba(5, 8, 22, 0), rgba(121, 242, 255, 0.12), rgba(5, 8, 22, 0));
      mix-blend-mode: screen;
    }

    .rocket-flash {
      background:
        radial-gradient(circle at 50% 92%, rgba(255, 255, 255, 0.95), rgba(121, 242, 255, 0.5) 20%, transparent 42%),
        radial-gradient(circle at 50% 88%, rgba(255, 179, 71, 0.65), transparent 18%);
      mix-blend-mode: screen;
      opacity: 0;
    }

    .rocket-launch {
      width: 72px;
      height: 210px;
      transform: translateX(-50%);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(212, 220, 232, 0.96) 18%, rgba(149, 160, 178, 0.96) 58%, rgba(73, 84, 100, 0.98));
      clip-path: polygon(50% 0%, 63% 10%, 70% 18%, 76% 28%, 76% 70%, 100% 82%, 100% 100%, 0 100%, 0 82%, 24% 70%, 24% 28%, 30% 18%, 37% 10%);
      filter: drop-shadow(0 0 16px rgba(255, 179, 71, 0.55)) drop-shadow(0 0 26px rgba(121, 242, 255, 0.45));
      transform-origin: center bottom;
      opacity: 0;
    }

    .rocket-launch::before {
      content: '';
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 22px solid transparent;
      border-right: 22px solid transparent;
      border-bottom: 38px solid rgba(255, 255, 255, 0.98);
      filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.28));
    }

    .rocket-launch::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -92px;
      transform: translateX(-50%);
      width: 46px;
      height: 110px;
      background: radial-gradient(ellipse at center, rgba(255, 179, 71, 1), rgba(255, 104, 37, 0.92) 40%, rgba(121, 242, 255, 0.18) 72%, transparent 80%);
      clip-path: polygon(50% 0%, 64% 16%, 78% 40%, 88% 66%, 50% 100%, 12% 66%, 22% 40%, 36% 16%);
      filter: blur(3px);
      opacity: 0.98;
    }

    .rocket-trail {
      width: 34px;
      height: 100vh;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(180deg, rgba(255, 179, 71, 0), rgba(255, 179, 71, 0.78), rgba(121, 242, 255, 0.18), rgba(5, 8, 22, 0));
      filter: blur(22px);
      opacity: 0;
    }

    .about-stage::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 60;
      pointer-events: none;
      opacity: 0;
      background:
        radial-gradient(circle at 50% 50%, rgba(121, 242, 255, 0.18), transparent 30%),
        radial-gradient(circle at 50% 92%, rgba(255, 179, 71, 0.18), transparent 16%);
    }

    .about-stage.is-rumbling::before {
      animation: pageRumble 5s linear forwards;
    }

    .about-stage.is-rumbling .space-shake,
    .about-stage.is-rumbling .space-shake * {
      animation: contentShake 0.18s linear infinite;
      will-change: transform;
    }

    .about-stage.is-rumbling .rocket-rumble {
      animation: pageRumble 5s linear forwards;
    }

    .about-stage.is-rumbling .rocket-whoosh {
      animation: pageWhoosh 4s ease-out forwards;
    }

    .about-stage.is-rumbling .rocket-launch {
      animation: rocketLaunch 4s cubic-bezier(0.16, 0.84, 0.2, 1) forwards;
    }

    .about-stage.is-rumbling .rocket-trail {
      animation: trailGlow 4s ease-out forwards;
    }

    .about-stage.is-rumbling .rocket-flash {
      animation: flashBurst 1.2s ease-out forwards;
    }

    @keyframes pageRumble {
      0% { opacity: 0; }
      8% { opacity: 0.75; }
      18% { opacity: 1; }
      100% { opacity: 0; }
    }

    @keyframes pageWhoosh {
      0% { opacity: 0; }
      12% { opacity: 0.85; }
      100% { opacity: 0; }
    }

    @keyframes rocketLaunch {
      0% { opacity: 0; transform: translateX(-50%) translateY(0) scale(0.7); }
      8% { opacity: 1; transform: translateX(-50%) translateY(-10vh) scale(0.78); }
      22% { transform: translateX(-50%) translateY(-26vh) scale(0.9); }
      45% { transform: translateX(-50%) translateY(-58vh) scale(1.02); }
      70% { transform: translateX(-50%) translateY(-90vh) scale(1.1); }
      100% { opacity: 1; transform: translateX(-50%) translateY(-138vh) scale(1.16); }
    }

    @keyframes trailGlow {
      0% { opacity: 0; }
      10% { opacity: 0.9; }
      100% { opacity: 0; }
    }

    @keyframes flashBurst {
      0% { opacity: 0; }
      10% { opacity: 1; }
      100% { opacity: 0; }
    }

    @keyframes contentShake {
      0% { transform: translate(0, 0) rotate(0deg); }
      20% { transform: translate(-6px, 4px) rotate(-0.25deg); }
      40% { transform: translate(6px, -4px) rotate(0.25deg); }
      60% { transform: translate(-5px, 5px) rotate(-0.2deg); }
      80% { transform: translate(5px, -3px) rotate(0.2deg); }
      100% { transform: translate(0, 0) rotate(0deg); }
    }
  </style>
</BaseLayout>
