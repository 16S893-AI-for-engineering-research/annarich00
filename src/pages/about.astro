---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePath } from '../lib/paths';

const photos = [
  {
    src: '/images/wedding-charlie.jpg',
    alt: 'Anna and Charlie at a wedding',
    span: 'md:col-span-2 md:row-span-2 object-[50%_35%]',
  },
  {
    src: '/images/ULArocket-photo.jpg',
    alt: 'Anna near a ULA rocket',
    span: 'rocket-card md:col-span-1 md:row-span-2 object-[50%_40%]',
  },
  { src: '/images/backpacking.jpg', alt: 'Anna backpacking outdoors', span: 'md:col-span-1' },
  { src: '/images/faith.jpg', alt: 'Anna at church or a faith event', span: 'md:col-span-1 object-[50%_38%]' },
  { src: '/images/surf-anna.jpg', alt: 'Anna surfing', span: 'md:col-span-1' },
  { src: '/images/family.jpg', alt: 'Anna with family', span: 'md:col-span-1' },
];
---

<BaseLayout title="Hiya! I'm Anna" description="Background, research interests, and project motivation.">
  <section class="about-stage space-y-8">
    <div class="space-shake space-y-8">
      <div class="space-y-4">
        <h1 class="text-4xl font-bold">Welcome! I&apos;m Anna</h1>
        <p class="max-w-3xl text-slate-300">
          I am a Space Force fellow focused on orbital analysis and AI-assisted trajectory design for mission planning. My time as an engineer at Vandenberg Space Force Base gave me firsthand experience working with launch companies like United Launch Alliance--mainly with their Vulcan rocket!
        </p>
        <p class="max-w-3xl text-slate-300">
          I chose this project with my advisor because we both see a real gap between what large language models can say about trajectory design and what active-duty operators and engineers can actually use. Outside of the classroom, my husband, Charlie, and I love backpacking, surfing, and just about any outdoor sport! We got married in April of this year and I have a photo of that below along with some others. I hope to bring the same curiosity and energy to my research here at MIT. Faith and family are deeply important to me, and Charlie and I were active in a wonderful church community in California where we helped with kids' church.
        </p>
        <p class="max-w-3xl text-orbital/90">
          Click my rocket photo for a fun surprise ;)
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3 md:auto-rows-[180px]">
        {photos.map((photo) => (
          <figure class={`photo-card group relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-glow ${photo.span}`}>
            {photo.src === '/images/ULArocket-photo.jpg' ? (
              <button type="button" class="rocket-trigger h-full w-full text-left" aria-label="Launch rocket animation" data-rocket-trigger>
                <img src={resolvePath(photo.src)} alt={photo.alt} class="h-full w-full object-cover object-[50%_40%]" />
                <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-black/60 px-3 py-2 text-xs text-white/90 backdrop-blur">
                  Click to launch
                </span>
              </button>
            ) : (
              <img src={resolvePath(photo.src)} alt={photo.alt} class={`h-full w-full object-cover transition duration-500 group-hover:scale-105 group-hover:brightness-110 ${photo.src === '/images/wedding-charlie.jpg' ? 'object-[50%_35%]' : ''} ${photo.src === '/images/faith.jpg' ? 'object-[50%_38%]' : ''}`} />
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <div class="launch-stage pointer-events-none fixed inset-0 z-[999] hidden" aria-hidden="true">
    <div class="launch-rumble"></div>
    <div class="launch-flash"></div>
    <div class="launch-trail"></div>
    <div class="launch-rocket"></div>
  </div>

  <script is:inline>
    const trigger = document.querySelector('[data-rocket-trigger]');
    const launchStage = document.querySelector('.launch-stage');
    const stage = document.querySelector('.about-stage');

    if (trigger && launchStage && stage) {
      const startLaunch = () => {
        launchStage.classList.remove('hidden');
        launchStage.classList.remove('is-launching');
        stage.classList.remove('is-launching');
        void launchStage.offsetWidth;
        launchStage.classList.add('is-launching');
        stage.classList.add('is-launching');
        window.setTimeout(() => {
          launchStage.classList.remove('is-launching');
          stage.classList.remove('is-launching');
          launchStage.classList.add('hidden');
        }, 4200);
      };

      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        startLaunch();
      });
    }
  </script>

  <style>
    .about-stage {
      position: relative;
    }

    .about-stage.is-launching .space-shake {
      animation: pageShake 0.18s linear infinite;
    }

    .about-stage.is-launching .space-shake > * {
      animation: pageShakeAlt 0.18s linear infinite;
    }

    .rocket-trigger {
      display: block;
      border: 0;
      padding: 0;
      background: transparent;
      cursor: pointer;
    }

    .launch-stage {
      overflow: hidden;
      pointer-events: none;
    }

    .launch-rumble,
    .launch-flash,
    .launch-trail,
    .launch-rocket {
      position: fixed;
      left: 50%;
      pointer-events: none;
      transform: translateX(-50%);
      opacity: 0;
      will-change: transform, opacity;
    }

    .launch-rumble {
      inset: 0;
      background:
        radial-gradient(circle at 50% 50%, rgba(121, 242, 255, 0.12), transparent 28%),
        radial-gradient(circle at 50% 90%, rgba(255, 179, 71, 0.12), transparent 18%);
      mix-blend-mode: screen;
      z-index: 9996;
    }

    .launch-flash {
      inset: 0;
      background:
        radial-gradient(circle at 50% 92%, rgba(255, 255, 255, 0.95), rgba(121, 242, 255, 0.4) 20%, transparent 42%),
        radial-gradient(circle at 50% 88%, rgba(255, 179, 71, 0.6), transparent 18%);
      mix-blend-mode: screen;
      z-index: 9997;
    }

    .launch-trail {
      bottom: -12vh;
      width: 42px;
      height: 100vh;
      background: linear-gradient(180deg, rgba(255, 179, 71, 0), rgba(255, 179, 71, 0.8), rgba(121, 242, 255, 0.18), rgba(5, 8, 22, 0));
      filter: blur(20px);
      z-index: 9998;
    }

    .launch-rocket {
      bottom: -18vh;
      width: 72px;
      height: 210px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(212, 220, 232, 0.96) 18%, rgba(149, 160, 178, 0.96) 58%, rgba(73, 84, 100, 0.98));
      clip-path: polygon(50% 0%, 63% 10%, 70% 18%, 76% 28%, 76% 70%, 100% 82%, 100% 100%, 0 100%, 0 82%, 24% 70%, 24% 28%, 30% 18%, 37% 10%);
      filter: drop-shadow(0 0 18px rgba(255, 179, 71, 0.6)) drop-shadow(0 0 28px rgba(121, 242, 255, 0.45));
      transform-origin: center bottom;
      z-index: 9999;
    }

    .launch-rocket::before {
      content: '';
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 22px solid transparent;
      border-right: 22px solid transparent;
      border-bottom: 38px solid rgba(255, 255, 255, 0.98);
      filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.28));
    }

    .launch-rocket::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -92px;
      transform: translateX(-50%);
      width: 46px;
      height: 110px;
      background: radial-gradient(ellipse at center, rgba(255, 179, 71, 1), rgba(255, 104, 37, 0.92) 40%, rgba(121, 242, 255, 0.18) 72%, transparent 80%);
      clip-path: polygon(50% 0%, 64% 16%, 78% 40%, 88% 66%, 50% 100%, 12% 66%, 22% 40%, 36% 16%);
      filter: blur(3px);
      opacity: 0.98;
    }

    .launch-stage.is-launching .launch-rumble {
      animation: rumble 5s linear forwards;
    }

    .launch-stage.is-launching .launch-flash {
      animation: flash 1s ease-out forwards;
    }

    .launch-stage.is-launching .launch-trail {
      animation: trail 4s ease-out forwards;
    }

    .launch-stage.is-launching .launch-rocket {
      animation: rocket 4s cubic-bezier(0.16, 0.84, 0.2, 1) forwards;
    }

    @keyframes rumble {
      0% { opacity: 0; transform: translateX(-50%) scale(1); }
      10% { opacity: 1; }
      20% { transform: translateX(-50%) translateY(-2px); }
      30% { transform: translateX(-50%) translateY(2px); }
      40% { transform: translateX(-50%) translateY(-3px); }
      50% { transform: translateX(-50%) translateY(3px); }
      100% { opacity: 0; transform: translateX(-50%) scale(1); }
    }

    @keyframes pageShake {
      0% { transform: translate(0, 0); }
      20% { transform: translate(-8px, 4px); }
      40% { transform: translate(7px, -5px); }
      60% { transform: translate(-6px, 5px); }
      80% { transform: translate(5px, -3px); }
      100% { transform: translate(0, 0); }
    }

    @keyframes pageShakeAlt {
      0% { transform: translate(0, 0); }
      20% { transform: translate(6px, -3px); }
      40% { transform: translate(-7px, 4px); }
      60% { transform: translate(5px, -4px); }
      80% { transform: translate(-5px, 3px); }
      100% { transform: translate(0, 0); }
    }

    @keyframes flash {
      0% { opacity: 0; }
      10% { opacity: 1; }
      100% { opacity: 0; }
    }

    @keyframes trail {
      0% { opacity: 0; }
      10% { opacity: 0.9; }
      100% { opacity: 0; }
    }

    @keyframes rocket {
      0% { opacity: 0; transform: translateX(-50%) translateY(0) scale(0.72); }
      8% { opacity: 1; transform: translateX(-50%) translateY(-10vh) scale(0.78); }
      22% { transform: translateX(-50%) translateY(-26vh) scale(0.9); }
      45% { transform: translateX(-50%) translateY(-58vh) scale(1.02); }
      70% { transform: translateX(-50%) translateY(-90vh) scale(1.1); }
      100% { opacity: 1; transform: translateX(-50%) translateY(-138vh) scale(1.16); }
    }
  </style>
</BaseLayout>
