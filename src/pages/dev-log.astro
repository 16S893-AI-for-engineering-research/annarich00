---
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = [
  {
    date: '2026-09-16',
    title: 'Counted my lengthiest session on September 11 by session messages and tool calls',
    summary: "Messages: 58 Tool Calls: 174 ",
    details: "I used these two commands to investigate the details of my run on Sept 11: grep -o ''role':'user'' ~/.pi/agent/sessions/--home-anna_ford--/2026-09-11T18-38-51-749Z_01a091c3-ed62-701b-81b5-ecbd1ab73f3c.jsonl | wc -l and grep -o ''type':'toolCall'' ~/.pi/agent/sessions/--home-anna_ford--/2026-09-11T18-38-51-749Z_01a091c3-ed62-701b-81b5-ecbd1ab73f3c.jsonl | wc -l"
  },

  {
    date: '2026-09-14',
    title: 'Added a click feature',
    summary: "I wanted to add a click feature to take me to a site where I can present weekly to my advisor with progess I've made and updates.",
    details: "Clicking \"Ctrl+S\" opens up a \"thesis\" pop-up that should have a link to the site in my own repository, where I update my weekly progress with papers I've read pertaining to my research."
  },
  {
    date: '2026-09-11',
    title: 'Started this Assignment',
    summary: "I gave a quick prompt to GPT mini 5.4, requesting a website meeting the class requirements. I refined the website based on other students' projects and my expectations.",
    details: "The resulting product was a very basic HTML site. When I saw other students work, I asked the model to refine what I had originally asked for and to use the tools they used, Astro and Tailwind CSS."
  },
];
---

<BaseLayout title="Dev Log | Agents in a Rendezvous" description="Weekly research updates and progress notes.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">Dev Log</h1>
    <p class="text-slate-300">These entries summarize the website content drafted during this session. Add future updates only when new site content or project progress is ready.</p>
    <div class="space-y-4">
      {entries.map((entry) => (
        <details class="card group">
          <summary class="cursor-pointer list-none">
            <p class="text-sm text-orbital">{entry.date}</p>
            <h2 class="mt-2 text-xl font-semibold">{entry.title}</h2>
            <p class="mt-2 text-slate-300">{entry.summary}</p>
            <p class="mt-2 text-sm text-thruster">Click to expand for more detail.</p>
          </summary>
          <div class="mt-4 border-t border-white/10 pt-4 text-slate-300">
            {entry.details}
          </div>
        </details>
      ))}
    </div>
    <div class="card">
      <h2 class="text-xl font-semibold">Template for future entries</h2>
      <pre class="mt-3 overflow-x-auto rounded-xl bg-black/30 p-4 text-sm text-slate-200">Date: YYYY-MM-DD
Title: Short update
Summary: One-sentence overview of the new site or project work.
Details: Expanded details on the specific changes made.</pre>
    </div>
  </section>
</BaseLayout>
