---
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = [
  {
    date: '2026-09-14',
    title: 'Added a click feature',
    summary: 'I wanted to add a click feature to take me to a site where I can present weekly to my advisor with progess I've made and updates.',
    details: 'Clicking "Ctrl+S" opens up a "thesis" pop-up that should have a link to the site in my own repository, where I update my weekly progress with papers I've read pertaining to my research area and any work I've completed and/or hope to get done.',
  },
  {
    date: '2026-09-11',
    title: 'Started this Assignment',
    summary: 'I gave a quick prompt to GPT mini 5.4, requesting a website meeting the class requirements. I refined the website based on other students' projects and my expectations.',
    details: 'The resulting product was a very basic HTML site. When I saw other students work, I asked the model to refine what I had orginally asked for and to use the tools they used, Astra and Tailwind. I went back and forth with the model to add an easter egg on the "About Me" page and to add some cool designs to the background. One note: the model generated the basic wording for my project since I gave it a rough draft of what I hope to accomplish in this class and what I hope my thesis evolves into. Since I don't have a written thesis/any papers on my project yet, I liked some of what it said--keeping some wording, while adjusting others. All the project descriptions now reflect what I believe to be a true representaion of my project.',
  },
];
---

<BaseLayout title="Dev Log | Agents in a Rendezvous" description="Weekly research updates and progress notes.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">Dev Log</h1>
    <p class="text-slate-300">These entries summarize the website content drafted during this session. Add future updates only when new site content or project progress is ready.</p>
    <div class="space-y-4">
      {entries.map((entry) => (
        <details class="card group">
          <summary class="cursor-pointer list-none">
            <p class="text-sm text-orbital">{entry.date}</p>
            <h2 class="mt-2 text-xl font-semibold">{entry.title}</h2>
            <p class="mt-2 text-slate-300">{entry.summary}</p>
            <p class="mt-2 text-sm text-thruster">Click to expand for more detail.</p>
          </summary>
          <div class="mt-4 border-t border-white/10 pt-4 text-slate-300">
            {entry.details}
          </div>
        </details>
      ))}
    </div>
    <div class="card">
      <h2 class="text-xl font-semibold">Template for future entries</h2>
      <pre class="mt-3 overflow-x-auto rounded-xl bg-black/30 p-4 text-sm text-slate-200">Date: YYYY-MM-DD\nTitle: Short update\nSummary: One-sentence overview of the new site or project work.\nDetails: A few more sentences about what changed, why it matters, and what comes next.</pre>
    </div>
  </section>
</BaseLayout>
