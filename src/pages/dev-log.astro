---
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = [
  {
    date: '2026-09-11',
    title: 'Reference site requested',
    summary: 'Asked for a structure similar to the class reference repository so the site would stay clean, efficient, and easy to maintain.',
    details: 'This guided the page organization, layout choices, and reusable components so the site could follow a clear and simple structure while still feeling polished.',
  },
  {
    date: '2026-09-11',
    title: 'Site scope defined',
    summary: 'Drafted a static Astro portfolio for Anna Ford-Richards with pages for Home, About, Project, and Dev Log.',
    details: 'This session set the foundation for the site structure, the GitHub Pages deployment path, and the overall space-themed visual style.',
  },
  {
    date: '2026-09-11',
    title: 'Content themes outlined',
    summary: 'Captured the Space Force, Vandenberg, cislunar, hiking, faith, family, and chocolate details that should appear on the site.',
    details: 'The About page now presents the bio in first person, links the narrative to your advisor, and includes your personal interests and family context.',
  },
  {
    date: '2026-09-11',
    title: 'Project focus finalized',
    summary: 'Framed the research question around whether agents can solve a classic two-body rendezvous problem accurately and translate results into current orbital propagation tools.',
    details: 'The project page now captures the problem statement, why it matters, the proposed solution workflow, milestones, success metrics, and data restrictions.',
  },
];
---

<BaseLayout title="Dev Log | Agents in a Rendezvous" description="Weekly research updates and progress notes.">
  <section class="space-y-6">
    <h1 class="text-4xl font-bold">Dev Log</h1>
    <p class="text-slate-300">These entries summarize the website content drafted during this session. Add future updates only when new site content or project progress is ready.</p>
    <div class="space-y-4">
      {entries.map((entry) => (
        <details class="card group">
          <summary class="cursor-pointer list-none">
            <p class="text-sm text-orbital">{entry.date}</p>
            <h2 class="mt-2 text-xl font-semibold">{entry.title}</h2>
            <p class="mt-2 text-slate-300">{entry.summary}</p>
            <p class="mt-2 text-sm text-thruster">Click to expand for more detail.</p>
          </summary>
          <div class="mt-4 border-t border-white/10 pt-4 text-slate-300">
            {entry.details}
          </div>
        </details>
      ))}
    </div>
    <div class="card">
      <h2 class="text-xl font-semibold">Template for future entries</h2>
      <pre class="mt-3 overflow-x-auto rounded-xl bg-black/30 p-4 text-sm text-slate-200">Date: YYYY-MM-DD\nTitle: Short update\nSummary: One-sentence overview of the new site or project work.\nDetails: A few more sentences about what changed, why it matters, and what comes next.</pre>
    </div>
  </section>
</BaseLayout>
